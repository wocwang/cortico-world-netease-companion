{
  "name": "better-cortico-world-netease-companion",
  "version": "1.12.0",
  "type": "module",
  "description": "和表达助手插件一起使用有奇效！读取网易云与 QQ 音乐曲目（需开启 SMTC）；切歌后让桌宠参考评论区、歌曲百科、歌手资料与歌词主动陪听，支持切歌报幕、同曲分段，并随歌曲情绪使用形象已有的动作/表情；同一首歌的多次评论会轮换侧重，副歌会按风格给动作建议；可在用户明确要求时暂停/切歌，也能搜歌并给出链接；记录听歌记忆与排名。只读元数据，不采集音频，不需要 API Key。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wocwang/cortico-world-netease-companion.git"
  },
  "homepage": "https://github.com/wocwang/cortico-world-netease-companion",
  "bugs": {
    "url": "https://github.com/wocwang/cortico-world-netease-companion/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "music",
    "qqmusic"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "听搭子",
    "tags": [
      "coopanion",
      "companion",
      "experimental",
      "sensitive-data",
      "external-setup",
      "internet",
      "unofficial-api"
    ],
    "describe": "describe.json",
    "webUiClient": "webui/client.js"
  },
  "files": [
    "src",
    "scripts",
    "webui",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "describe.json",
    "docs"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "describe": "tsx scripts/describe.ts",
    "prepack": "npm run describe",
    "diagnose": "tsx scripts/diagnose.ts",
    "check": "tsx scripts/check.ts",
    "verify": "npm run typecheck && npm test && npm run describe && npm run check",
    "check-comments": "tsx scripts/check-comments.ts",
    "check-host": "tsx scripts/check-host.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "0.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "wocwang",
    "url": "https://github.com/wocwang"
  },
  "contributors": [
    {
      "name": "oceanxuhaiao",
      "url": "https://github.com/oceanxuhaiao"
    }
  ]
}
